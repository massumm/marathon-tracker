{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git"]
    }
  ],
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      {
        "source": "**/*.apk",
        "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }]
      }
    ],
    "rewrites": [
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "runmate-252e5",
          "appId": "1:24360852719:android:37a76adddc9c22f1f14f1a",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "runmate-252e5",
          "appId": "1:24360852719:ios:78097c986b5999ecf14f1a",
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "runmate-252e5",
          "configurations": {
            "android": "1:24360852719:android:37a76adddc9c22f1f14f1a",
            "ios": "1:24360852719:ios:78097c986b5999ecf14f1a"
          }
        }
      }
    }
  }
}
